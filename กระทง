            คำอวยพรจากแตมอ้วง💗
        </h1>

        <div class="letter-card">

            <div class="letter-flower">🌷</div>

            <div class="letter-greeting">
                ถึงเนยอ้วงของแตม 💗
            </div>

            <div class="letter-content">
ในวันพิเศษแบบนี้ แตมมีคำอวยพรอยากบอกเนยนะคะะะะ

ขอบคุณสำหรับทุกๆอย่างนะคะที่ทำให้เค้ามาเสมอออ
ขอให้เราทั้งคู่อยุ่ด้วยกานจนมีครบทุกๆสิ่งนะคะะะ
อยากบอกว่า เค้าตั้งใจมำให้ดีที่สุดเลยนะคะ 
เค้ารักบี๋นะคะ ขอให้พรทุกข้อที่เค้ามีเป็นของบี๋นะคะ

ขอให้เบบี๋เนยยิ้มเยอะะๆๆๆนะคะะ
ขอให้ด้ายเกรดดีๆ เรียนเก่งๆเข้าจายยย
ขอให้มะเหนื่อย มะเพลียยยยยย

ขอบคุณที่เข้ามาเป็นความสุขในชีวติของเค้านะะ
เค้าดีจายมักกที่มีบี๋
สุดท้ายนี้ขอให้เราทั้งคู่มีกันและกันตลอดปาย มีแต่เรื่องดีๆนะคะ
อยุ่ดูแลเค้าปายนานนๆๆๆๆเลยนะคะะะ รักนะคะเนย💖
            </div>

            <div class="letter-divider"></div>

            <div class="letter-signature">
                รักเนยอ้วงนะคะ<br>
                จาก แตมอ้วงของเนย 💗
            </div>

            <div class="letter-decoration">
                ✿ ✧ ♡ ✧ ✿
            </div>

        </div>

        <button class="wish-back-button" onclick="backToSecondPage()">
            กลับไปหน้าลอยกระทง 🪷
        </button>

    </div>

</div>

<script>
function goToSecondPage() {
    document.getElementById("firstPage").style.display = "none";
    document.getElementById("secondPage").style.display = "block";

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}

function backToFirstPage() {
    document.getElementById("secondPage").style.display = "none";
    document.getElementById("firstPage").style.display = "block";

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}

/* เปิดหน้าคำอวยพร */
function goToWishPage() {
    document.getElementById("secondPage").style.display = "none";
    document.getElementById("wishPage").style.display = "block";

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}

/* กลับจากหน้าคำอวยพร */
function backToSecondPage() {
    document.getElementById("wishPage").style.display = "none";
    document.getElementById("secondPage").style.display = "block";

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}

function floatTogether() {

    const riverScene = document.getElementById("riverScene");
    const message = document.getElementById("togetherMessage");
    const button = document.getElementById("floatButton");
    const wishInput = document.getElementById("wishInput");

    if (riverScene.classList.contains("released")) {
        return;
    }

    /* เริ่มอนิเมชั่นกระทง */
    riverScene.classList.add("released");

    const wish = wishInput.value.trim();

    if (wish) {
        message.innerHTML =
            "กระทงของเราลอยไปพร้อมคำอธิษฐานแล้วนะคะ 🥹💗<br>" +
            "“" + escapeHTML(wish) + "”<br>" +
            "ขอให้คำอธิษฐานนี้เป็นจริงนะะ";
    } else {
        message.innerHTML =
            "ลอยไปด้วยกันแล้วนะคะ 🥹💗<br>" +
            "ขอให้เราได้อยู่ด้วยกันแบบนี้ไปนานๆเลย";
    }

    wishInput.disabled = true;
    button.innerHTML = "ลอยกระทงด้วยกันแล้ว 💗";
    button.disabled = true;
    button.style.opacity = ".7";

    const emojis = ["💗","✨","🌸","💕","🪷"];

    for (let i = 0; i < 35; i++) {
        const heart = document.createElement("div");

        heart.className = "heart";
        heart.innerHTML =
            emojis[Math.floor(Math.random() * emojis.length)];

        heart.style.left = Math.random() * 100 + "vw";
        heart.style.animationDuration =
            (3 + Math.random() * 4) + "s";
        heart.style.animationDelay =
            Math.random() * 2 + "s";

        document.body.appendChild(heart);

        setTimeout(() => heart.remove(), 9000);
    }
}

function escapeHTML(text) {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
}
</script>

</body>
</html>
